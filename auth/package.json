{
  "name": "auth",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "ts-node-dev --poll src/index.ts",
    "build": "tsc --noEmit",
    "test": "jest --watchAll --no-cache",
    "test:ci": "jest --no-cache",
    "refresh-common": "npm --prefix ../common run build && node -e \"require('fs').rmSync('node_modules/@mini-ticketing',{recursive:true,force:true})\" && npm install"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "./src/test/setup.ts"
    ]
  },
  "license": "ISC",
  "dependencies": {
    "@mini-ticketing/common": "file:../common",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "auth": "file:",
    "cookie-session": "^2.1.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.2"
  }
}
