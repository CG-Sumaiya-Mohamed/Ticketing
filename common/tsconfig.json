{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "declaration": true, /* Generate .d.ts files so the services get type checking from common. */
    "outDir": "./build",
    "rootDir": "./src",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
